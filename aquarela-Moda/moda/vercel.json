{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/moda", "destination": "/" },
    { "source": "/moda/", "destination": "/" },
    { "source": "/moda/:path*", "destination": "/:path*" }
  ],
  "headers": [
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
